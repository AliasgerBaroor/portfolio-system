generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum Visibility {
  PUBLIC
  PRIVATE
  PASSWORD
  UNLISTED
}

enum SectionType {
  HERO
  PROJECTS
  ABOUT
  EXPERIENCE
  CONTACT
  CUSTOM
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastSeenAt DateTime?

  @@index([userId])
}

model ProjectOverview {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  logo String?

  category String? // Travel

  shortDescription String?

  collaborators String?

  scope String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectGalleryImage {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  imageUrl String

  alt String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, sortOrder])
}

model Project {
  id String @id @default(cuid())

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  title String
  slug  String @unique

  summary    String?
  content    String?
  coverImage String?

  visibility Visibility @default(PUBLIC)

  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  isPublished Boolean @default(false)
  isArchived  Boolean @default(false)

  accessRules ProjectClientAccess[]

  details       ProjectOverview?
  galleryImages ProjectGalleryImage[]

  tags                ProjectTagAssignment[]
  portfolioCategories ProjectPortfolioCategory[]

  @@index([portfolioId])
  @@index([visibility])
}

// TODO
//ProjectMetric
//ProjectTechnology

model PortfolioClientAccess {
  accessKeyId String
  portfolioId String

  accessKey ClientAccessKey @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@id([accessKeyId, portfolioId])
  @@index([portfolioId])
  @@index([accessKeyId])
}

model ProjectClientAccess {
  accessKeyId String
  projectId   String

  accessKey ClientAccessKey @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([accessKeyId, projectId])
  @@index([projectId])
  @@index([accessKeyId])
}

model Client {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name    String
  company String?
  email   String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accessKeys ClientAccessKey[]

  accessRequests      ClientAccessRequest[]
  portfolioCategories ClientPortfolioCategory[]

  @@index([ownerId])
  @@index([email])
}

/// Password-protected access for clients.
model ClientAccessKey {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name String

  passwordHash      String
  encryptedPassword String

  credentialId String @unique

  expiresAt  DateTime
  lastSeenAt DateTime?

  maxUses     Int?
  deviceLimit Int  @default(1)
  usedCount   Int  @default(0)

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions ClientAccessSession[]

  portfolios PortfolioClientAccess[]
  projects   ProjectClientAccess[]

  lastUsedAt DateTime?
  logs       ClientAccessLog[]

  @@index([ownerId])
  @@index([clientId])
}

model ClientAccessSession {
  id String @id @default(cuid())

  accessKeyId String
  accessKey   ClientAccessKey @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)

  sessionTokenHash String @unique

  fingerprint String

  ip String?

  createdAt DateTime @default(now())

  expiresAt DateTime

  userAgent String?

  deviceName String?

  @@unique([accessKeyId, fingerprint])
  @@index([accessKeyId])
}

model ClientAccessRequest {
  id String @id @default(cuid())

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name    String
  email   String
  company String?

  message String?

  status AccessRequestStatus @default(PENDING)

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([portfolioId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model Portfolio {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  title String

  slug String @unique

  visibility  Visibility @default(PUBLIC)
  isPublished Boolean    @default(false)
  isArchived  Boolean    @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  projects Project[]

  accessRules PortfolioClientAccess[]

  sections PortfolioSection[]

  accessRequests ClientAccessRequest[]
  categories     PortfolioCategory[]

  updatedAt DateTime @updatedAt

  theme String?

  customDomain String? @unique

  favicon String?

  seoTitle String?

  seoDescription String?

  // ============================================================
// NEW CMS
// ============================================================

cmsCollections CmsCollection[]
  // ============================================================
// CLOSE NEW CMS
// ============================================================


  @@index([ownerId])
  @@index([slug])
}

model PortfolioSection {
  id String @id @default(cuid())

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  type SectionType

  title String
  slug  String

  sortOrder Int @default(0)

  isVisible Boolean @default(true)

  isLandingVisible Boolean @default(false)

  blocks PortfolioContentBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portfolioId, slug])
  @@index([portfolioId])
  @@index([portfolioId, sortOrder])
}

enum ContentBlockType {
  TEXT
  RICH_TEXT
  BULLET_LIST
  QUOTE
  IMAGE
  VIDEO
}

model PortfolioContentBlock {
  id String @id @default(cuid())

  sectionId String
  section   PortfolioSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  type ContentBlockType

  title   String?
  content Json?

  sortOrder Int @default(0)

  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([sectionId, sortOrder])
}

model PortfolioCategory {
  id String @id @default(cuid())

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  name String
  slug String

  sortOrder Int @default(0)

  clients  ClientPortfolioCategory[]
  projects ProjectPortfolioCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portfolioId, slug])
  @@index([portfolioId])
}

model ClientPortfolioCategory {
  clientId   String
  categoryId String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  category PortfolioCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([clientId, categoryId])
  @@index([categoryId])
}

model ProjectPortfolioCategory {
  projectId  String
  categoryId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category PortfolioCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@index([categoryId])
}

model User {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String

  username    String  @unique
  fullName    String
  displayName String
  avatar      String?

  bio String?

  isActive Boolean @default(true)

  role UserRole @default(ADMIN)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  portfolios Portfolio[]
  sessions   Session[]
  clients    Client[]
  accessKeys ClientAccessKey[]

  lastLoginAt DateTime?

  @@index([username])
}

model ClientAccessLog {
  id String @id @default(cuid())

  accessKeyId String
  accessKey   ClientAccessKey @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)

  ip String?

  fingerprint String?

  userAgent String?

  success Boolean

  country String?

  city String?

  browser String?

  os String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accessKeyId])
  @@index([createdAt])
}

model ProjectTag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  projects ProjectTagAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTagAssignment {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tag ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
}




// ============================================================
// NEW CMS — CURRENT
// ============================================================
//
// Scalable hierarchy:
//
// Portfolio
//   └── CmsCollection
//         └── CmsItem
//               └── CmsSection
//                     └── CmsBlock
//
// Collection = content type/group
// Item       = individual entry
// Section    = structural group inside an item
// Block      = actual content
//
// ============================================================

model CmsCollection {
    id String @id @default(cuid())

    portfolioId String
    portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

    name String
    slug String
    description String?

    // System collections are created automatically by the platform
    // and cannot be deleted through normal CMS operations.
    isSystem Boolean @default(false)

    isEnabled Boolean @default(true)
    sortOrder Int @default(0)

    items CmsItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([portfolioId, slug])
    @@index([portfolioId])
    @@index([portfolioId, sortOrder])
}


model CmsItem {
  id String @id @default(cuid())

  collectionId String
  collection CmsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  title String
  slug String

  description String?

  // Flexible item-level metadata/content.
  data Json?

  isPublished Boolean @default(false)
  isVisible Boolean @default(true)

  sortOrder Int @default(0)

  sections CmsSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([collectionId, slug])
  @@index([collectionId])
  @@index([collectionId, sortOrder])
  @@index([collectionId, isPublished])
}


model CmsSection {
  id String @id @default(cuid())

  itemId String
  item CmsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  title String
  slug String

  // Flexible instead of the OLD fixed SectionType enum.
  type String?

  sortOrder Int @default(0)

  isVisible Boolean @default(true)
  isSystem Boolean @default(false)

  blocks CmsBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, slug])
  @@index([itemId])
  @@index([itemId, sortOrder])
}


model CmsBlock {
  id String @id @default(cuid())

  sectionId String
  section CmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Examples:
  // text
  // rich-text
  // image
  // video
  // gallery
  // button
  // custom
  type String

  title String?

  // Block-specific data.
  content Json?

  sortOrder Int @default(0)

  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([sectionId, sortOrder])
}