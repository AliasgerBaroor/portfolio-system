{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
 "include": [
  "next-env.d.ts",
  "next.config.ts",
  "**/*.ts",
  "**/*.tsx",
  "**/*.mts",
  ".next/types/**/*.ts",
  ".next/dev/types/**/*.ts",
  "../../packages/ui/src/components/layout/inline-editor.tsx",
  "components/header/sections/site-visibility/client-passwords/client-passwords.tsx"
],
"exclude": [
  "node_modules"
]
}
